APP_NAME=MANI
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-long-random-mani-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# SQLite (default offline demo) or PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mani
DATABASE_URL=sqlite:///C:/Users/jorge/NASA_SPACE_APP/data/mani.db
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,https://158.101.2.100:9543,https://mani-nova3.duckdns.org,https://mani-web.ashysky-26ab9584.eastus.azurecontainerapps.io
PUBLIC_URL=https://158.101.2.100:9543
BACKEND_PORT=8100
# HORIZONS_FORCE_OFFLINE=true
# HORIZONS_MAX_COMPARE_DAYS=120

# Password reset email. Without SMTP_HOST, production returns SMTP_NOT_CONFIGURED;
# in development (APP_ENV=development) SMTP_PASSWORD_RESET_DEV_LOG logs the temp password.
#
# Gmail (recommended): enable 2FA → App Password → smtp.gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=you@gmail.com
# SMTP_USE_TLS=true
#
# Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=you@hotmail.com
# SMTP_PASSWORD=your-password-or-app-password
# SMTP_FROM=you@hotmail.com
# SMTP_USE_TLS=true
#
# SMTP_PASSWORD_RESET_DEV_LOG=true

# Google Sign-In (GIS ID token). Create an OAuth Client ID type "Web application"
# in Google Cloud Console → APIs & Services → Credentials.
# Authorized JavaScript origins:
#   http://localhost:3100
#   https://mani-nova3.duckdns.org
#   https://mani-web.ashysky-26ab9584.eastus.azurecontainerapps.io
# Authorized redirect URIs (same origins; / optional):
#   http://localhost:3100
#   https://mani-nova3.duckdns.org
#   https://mani-web.ashysky-26ab9584.eastus.azurecontainerapps.io
# Paste the Client ID below (and in frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# GOOGLE_CLIENT_SECRET is optional for ID-token flow; keep blank unless you use code exchange.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
